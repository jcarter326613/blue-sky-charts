<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.blueskycharts.app">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity android:name=".preferences.ManagePrivacyActivity"></activity>
        <activity android:name=".preferences.ManageMemoryActivity" />
        <activity
            android:name=".mapselection.MapSelectionActivity"
            android:label="Select Map"
            android:parentActivityName=".map.MapViewActivity" />
        <activity
            android:name=".preferences.DownloadPreferencesActivity"
            android:parentActivityName=".map.MapViewActivity" />
        <activity
            android:name=".map.MapViewActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".subscription.SubscriptionActivity"
            android:label="Subscription Required" />
        <activity
            android:name=".subscription.ManageSubscriptionActivity"
            android:label="Manage Subscription"
            android:parentActivityName=".map.MapViewActivity" />
        <activity
            android:name=".ConsentActivity"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />

        <service
            android:name=".map.resources.GeoLocationService"
            android:foregroundServiceType="location" />
    </application>

</manifest>